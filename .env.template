# PasteleryApp — Environment Variables
#
# Local development:
#   1. Copy this file to .env
#   2. Replace placeholder values with your Supabase project credentials
#
# Vercel production:
#   Configure the same variables in Project Settings > Environment Variables.
#   Never commit real credentials to GitHub.

# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable key (safe for browser usage)
SUPABASE_KEY=your_publishable_key_here

# Supabase service role key (local admin scripts only — never expose in the browser or commit)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
